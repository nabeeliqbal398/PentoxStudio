# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
# Postgres connection string (local Docker container "pentox-db")
DATABASE_URL=postgres://user:password@localhost:5432/dbname
# Payload secret used to sign sessions/JWTs (generate a long random string)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- AI chatbot (Groq, OpenAI-compatible) ---
# Groq API key (server-only)
GROQ_API_KEY=your-groq-api-key
# Groq model name used for chat
GROQ_MODEL=your-groq-model
# Groq OpenAI-compatible base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Local sentence-embedding model (Transformers.js) for pgvector
EMBEDDING_MODEL=your-embedding-model

# --- Email (SMTP via Nodemailer) ---
# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587
# SMTP username (mailbox or Gmail address)
SMTP_USER=your-smtp-user
# SMTP password (Gmail App Password or mailbox password)
SMTP_PASS=your-smtp-password
# Sender address for outgoing mail
EMAIL_FROM=hello@example.com
# Sender display name
EMAIL_FROM_NAME=Your Studio
# Address that receives new-lead notifications
LEAD_NOTIFY_TO=you@example.com

# --- Newsletter sending limits (optional; defaults are Gmail-friendly) ---
# Messages sent per batch
NEWSLETTER_BATCH_SIZE=20
# Pause between batches, in seconds (the job queue checks once a minute, so 60 is the practical minimum)
NEWSLETTER_BATCH_DELAY_SECONDS=60
# Pause between individual messages, in milliseconds
NEWSLETTER_MESSAGE_DELAY_MS=1000
# Maximum newsletter messages per day across all campaigns (Gmail personal ~500, Workspace ~2000)
NEWSLETTER_DAILY_LIMIT=400

# --- Public site config (NEXT_PUBLIC_* is exposed to the browser: no secrets here) ---
# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID (loaded after cookie consent)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Tag Manager container ID (loaded after cookie consent)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Microsoft Clarity project ID (loaded after cookie consent)
NEXT_PUBLIC_CLARITY_ID=your-clarity-id

# --- Spam protection (Cloudflare Turnstile; optional) ---
# Turnstile site key (public)
TURNSTILE_SITE_KEY=your-turnstile-site-key
# Turnstile secret (server-only; enables Turnstile when set)
TURNSTILE_SECRET=your-turnstile-secret

# --- Booking / contact ---
# Cal.com or Calendly booking URL
BOOKING_URL=https://cal.com/your-handle
# WhatsApp number in international format, digits only
WHATSAPP_NUMBER=10000000000
